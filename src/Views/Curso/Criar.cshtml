@model SaberMais.Models.CursoViewModel
@{

    ViewData["Title"] = "Cadastrar Curso";

}


<style>
    .form-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0f141a 0%, #1a2730 50%, #0f141a 100%);
        padding: 40px 20px;
    }

    .card-custom {
        background: linear-gradient(145deg, #1e2d3d, #141e29);
        border: 1px solid rgba(176, 206, 226, 0.1);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .form-label-custom {
        color: #b0cee2;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 8px;
    }

    .form-control-custom {
        background-color: #0f1a24 !important;
        border: 1px solid rgba(176, 206, 226, 0.2) !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 12px 16px;
        transition: all 0.3s ease;
    }

        .form-control-custom:focus {
            background-color: #1a2730 !important;
            border-color: #00bfa6 !important;
            box-shadow: 0 0 0 3px rgba(0, 191, 166, 0.1);
        }

        .form-control-custom::placeholder {
            color: #6b8299;
        }

    .radio-container {
        background: rgba(0, 191, 166, 0.05);
        border: 1px solid rgba(0, 191, 166, 0.2);
        border-radius: 12px;
        padding: 16px;
    }

    .radio-option {
        background: #0f1a24;
        border: 2px solid rgba(176, 206, 226, 0.2);
        border-radius: 10px;
        padding: 12px 24px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .radio-option:hover {
            border-color: #00bfa6;
            background: rgba(0, 191, 166, 0.1);
        }

        .radio-option:has(label[for="radioEad"]) {
            border-color: rgba(176, 206, 226, 0.2);
        }

        .radio-option:has(label[for="radioPresencial"]) {
            border-color: rgba(176, 206, 226, 0.2);
        }

    #radioEad:checked ~ div .radio-option:has(label[for="radioEad"]) {
        border-color: #00bfa6;
        background: rgba(0, 191, 166, 0.15);
    }

        #radioEad:checked ~ div .radio-option:has(label[for="radioEad"]) label {
            color: #00bfa6 !important;
            font-weight: 700;
        }

    #radioPresencial:checked ~ div .radio-option:has(label[for="radioPresencial"]) {
        border-color: #00bfa6;
        background: rgba(0, 191, 166, 0.15);
    }

        #radioPresencial:checked ~ div .radio-option:has(label[for="radioPresencial"]) label {
            color: #00bfa6 !important;
            font-weight: 700;
        }

    .endereco-section {
        background: linear-gradient(145deg, #243442, #1a2730);
        border: 1px solid rgba(93, 173, 226, 0.3);
        border-radius: 16px;
        padding: 0;
        box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.2);
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        margin-bottom: 0;
        transition: max-height 0.6s ease, opacity 0.6s ease, padding 0.6s ease, margin-bottom 0.6s ease;
    }

    #radioPresencial:checked ~ .mb-4 .endereco-wrapper .endereco-section {
        max-height: 600px;
        opacity: 1;
        padding: 24px;
        margin-bottom: 0;
    }

    #radioEad:checked ~ .mb-4 .endereco-wrapper .endereco-section {
        max-height: 0;
        opacity: 0;
        padding: 0;
        margin-bottom: 0;
    }

    .endereco-title {
        color: #5dade2;
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid rgba(93, 173, 226, 0.3);
    }

    .btn-submit {
        background: linear-gradient(135deg, #00bfa6, #00d4b8);
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        box-shadow: 0 6px 20px rgba(0, 191, 166, 0.3);
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            background: linear-gradient(135deg, #00d4b8, #00bfa6);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 191, 166, 0.4);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

    .page-title {
        color: #ffffff;
        font-weight: 800;
        font-size: 2.2rem;
        text-shadow: 0 2px 10px rgba(0, 191, 166, 0.3);
        margin-bottom: 30px;
    }

    .alert-success {
        background: linear-gradient(135deg, #00bfa6, #00d4b8);
        border: none;
        border-radius: 12px;
        color: white;
        font-weight: 600;
    }

    .text-danger {
        color: #ff6b6b !important;
        font-size: 0.85rem;
        margin-top: 6px;
        font-weight: 500;
    }

    .field-validation-error {
        color: #ff6b6b;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
    }

    .input-validation-error {
        border-color: #ff6b6b !important;
        background-color: rgba(255, 107, 107, 0.05) !important;
    }
</style>

<div class="form-container d-flex justify-content-center align-items-center">
    <div class="card-custom p-5 rounded-4" style="width: 650px; max-width: 95%;">
        <h2 class="page-title text-center">Cadastrar Curso</h2>


        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success text-center mb-4">
                @TempData["Sucesso"]
            </div>
        }

        <form asp-action="Criar" asp-controller="Curso" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" style="border-radius: 12px; background: linear-gradient(135deg, #ff6b6b, #ff8787); border: none;"></div>

            <input type="radio" asp-for="Presencial" value="false" checked class="d-none" id="radioEad" />
            <input type="radio" asp-for="Presencial" value="true" class="d-none" id="radioPresencial" />

            <div class="mb-4">
                <label asp-for="Cpf" class="form-label-custom">CPF do Responsável</label>
                <input asp-for="Cpf"
                       class="form-control form-control-custom"
                       placeholder="Ex: 12345678900 (apenas números)"
                       maxlength="11"
                       inputmode="numeric"
                       required />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Titulo" class="form-label-custom">Título do Curso</label>
                <input asp-for="Titulo"
                       class="form-control form-control-custom"
                       placeholder="Ex: Curso de Sociologia Avançada"
                       required
                       minlength="3"
                       maxlength="100" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Descricao" class="form-label-custom">Sobre o Curso</label>
                <textarea asp-for="Descricao"
                          class="form-control form-control-custom"
                          rows="5"
                          placeholder="Descreva os principais tópicos e objetivos do curso..."
                          required
                          minlength="10"
                          maxlength="1000"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Valor" class="form-label-custom">Valor (R$)</label>
                <input asp-for="Valor"
                       class="form-control form-control-custom"
                       placeholder="0,00"
                       required
                       type="number"
                       step="0.01"
                       min="0"
                       max="999999" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label-custom">Tipo de Curso</label>
                <div class="radio-container">
                    <div class="d-flex gap-3 justify-content-center">
                        <div class="radio-option flex-fill text-center">
                            <label class="text-white w-100" for="radioEad" style="cursor: pointer;">
                                EAD
                            </label>
                        </div>
                        <div class="radio-option flex-fill text-center">
                            <label class="text-white w-100" for="radioPresencial" style="cursor: pointer;">
                                Presencial
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <div class="endereco-wrapper">
                    <div class="endereco-section">
                        <h6 class="endereco-title">Endereço do Curso Presencial</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <input asp-for="Cep"
                                       class="form-control form-control-custom"
                                       placeholder="Ex: 30130100 (apenas números)"
                                       maxlength="8"
                                       inputmode="numeric" />
                                <span asp-validation-for="Cep" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <input asp-for="Logradouro"
                                       class="form-control form-control-custom"
                                       placeholder="Logradouro"
                                       maxlength="100" />
                                <span asp-validation-for="Logradouro" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <input asp-for="Numero"
                                       class="form-control form-control-custom"
                                       placeholder="Nº"
                                       maxlength="10" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <input asp-for="Bairro"
                                       class="form-control form-control-custom"
                                       placeholder="Bairro"
                                       maxlength="50" />
                                <span asp-validation-for="Bairro" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <input asp-for="Complemento"
                                       class="form-control form-control-custom"
                                       placeholder="Complemento"
                                       maxlength="100" />
                                <span asp-validation-for="Complemento" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <input asp-for="Uf"
                                       class="form-control form-control-custom"
                                       placeholder="UF"
                                       maxlength="2"
                                       style="text-transform: uppercase;" />
                                <span asp-validation-for="Uf" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Imagem" class="form-label-custom">Imagem do Curso</label>
                <input asp-for="Imagem"
                       type="file"
                       class="form-control form-control-custom"
                       accept="image/jpeg,image/png,image/jpg,image/gif" />
                <span asp-validation-for="Imagem" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Arquivo" class="form-label-custom">Arquivo do Curso</label>
                <input asp-for="Arquivo"
                       type="file"
                       class="form-control form-control-custom"
                       accept=".pdf,.doc,.docx,.zip" />
                <span asp-validation-for="Arquivo" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Recomendado" />
                <label class="form-check-label text-white" asp-for="Recomendado">
                    Marcar como recomendado
                </label>
            </div>

            <button type="submit" class="btn btn-submit w-100 text-white">
                Cadastrar Curso
            </button>
        </form>
    </div>
</div>