@{
    ViewData["Title"] = "Perfil de Usuário";
    var usuario = ViewBag.Usuario as SaberMais.Models.Usuario;
    var avaliacoes = ViewBag.Avaliacoes as List<SaberMais.Models.Avaliacao>;
    var mediaNotas = ViewBag.MediaNotas;
    var totalAvaliacoes = ViewBag.TotalAvaliacoes;
}

<div class="container mt-4">
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- PERFIL DO USUÁRIO -->
    <div class="card bg-dark text-light mb-4">
        <div class="card-body text-center">
            @if (!string.IsNullOrEmpty(usuario.FotoPerfil))
            {
                <img src="/uploads/@usuario.FotoPerfil" alt="Foto de Perfil"
                     class="rounded-circle mb-3"
                     style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #00bfa6;" />
            }
            else
            {
                <img src="/images/default-user.png" alt="Foto de Perfil"
                     class="rounded-circle mb-3"
                     style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #00bfa6;" />
            }

            <h3 class="text-info">@usuario.NomeCompleto</h3>
            <p class="text-muted">@usuario.Email</p>

            <!-- MÉDIA DE AVALIAÇÕES -->
            <div class="mt-3">
                <h4 class="text-warning">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(mediaNotas))
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-star"></i>
                        }
                    }
                    <span class="ms-2">@mediaNotas.ToString("0.0")</span>
                </h4>
                <small class="text-muted">(@totalAvaliacoes avaliações)</small>
            </div>

            <!-- BOTÕES DE AÇÃO -->
            <div class="mt-4">
                <a asp-action="Avaliar" asp-route-usuarioId="@usuario.Id" class="btn btn-primary">
                    <i class="bi bi-star-fill me-2"></i>Avaliar este usuário
                </a>
                <a asp-controller="Mensagem" asp-action="Enviar" asp-route-destinatarioId="@usuario.Id" class="btn btn-success ms-2">
                    <i class="bi bi-envelope-fill me-2"></i>Enviar mensagem
                </a>
            </div>
        </div>
    </div>

    <!-- LISTA DE AVALIAÇÕES -->
    <div class="card bg-dark text-light">
        <div class="card-header bg-secondary">
            <h4 class="mb-0">
                <i class="bi bi-chat-quote-fill me-2"></i>Avaliações recebidas
            </h4>
        </div>
        <div class="card-body">
            @if (avaliacoes != null && avaliacoes.Any())
            {
                @foreach (var avaliacao in avaliacoes)
                {
                    <div class="border-bottom border-secondary pb-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong class="text-info">@avaliacao.UsuarioAvaliador.NomeCompleto</strong>
                                <div class="text-warning mt-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= avaliacao.Nota)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </div>
                            </div>
                            <small class="text-muted">@avaliacao.DataAvaliacao.ToString("dd/MM/yyyy")</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(avaliacao.Comentario))
                        {
                            <p class="mt-2 mb-0">@avaliacao.Comentario</p>
                        }

                        @* Botão de exclusão só aparece para o dono da avaliação *@
                        @if (User.Identity.IsAuthenticated)
                        {
                            var emailLogado = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                            if (avaliacao.UsuarioAvaliador.Email == emailLogado)
                            {
                                <form asp-action="Excluir" asp-route-id="@avaliacao.Id" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Deseja excluir esta avaliação?')">
                                        <i class="bi bi-trash-fill"></i> Excluir
                                    </button>
                                </form>
                            }
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-emoji-frown fs-2 d-block mb-2"></i>
                    <p>Este usuário ainda não possui avaliações.</p>
                </div>
            }
        </div>
    </div>
</div>