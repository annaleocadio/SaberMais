<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Saber+</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet" />
    <style>
        /* ==== EFEITO VIDRO + AJUSTES DE MODAL ==== */
        .modal-content {
            border-radius: 15px;
            background: rgba(26, 39, 48, 0.85) !important;
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
        }

        .modal-header,
        .modal-footer {
            background: rgba(15, 20, 26, 0.8);
        }

        .modal-title {
            color: #b0cee2;
            font-weight: 600;
        }

        .btn-outline-info {
            border-color: #00bfa6;
            color: #00bfa6;
        }

            .btn-outline-info:hover {
                background-color: #00bfa6;
                color: #fff;
            }

        .btn-primary {
            background-color: #00bfa6;
            border: none;
        }

            .btn-primary:hover {
                background-color: #00dcb8;
            }

        /* ==== NAVBAR DARK ==== */
        .saber-navbar {
            background-color: #151d25 !important;
        }

            .saber-navbar .nav-link {
                color: #b0cee2 !important;
                transition: 0.3s;
            }

                .saber-navbar .nav-link:hover {
                    color: #00bfa6 !important;
                }

        .saber-footer {
            background-color: #0f141a;
            color: #888;
            text-align: center;
            padding: 10px 0;
        }
    </style>
</head>

<body class="bg-dark-saber">
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark saber-navbar shadow-sm fixed-top">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Saber+</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-success fw-semibold ms-lg-2" asp-controller="Curso" asp-action="Criar">
                                    <i class="bi bi-plus-circle me-1"></i> Cadastrar Curso
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Perfil" asp-action="Index">Perfil</a>
                            </li>

                            <li class="nav-item ms-2">
                                <form asp-controller="Usuario" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light fw-semibold">Sair</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <button class="btn btn-link nav-link" data-bs-toggle="modal" data-bs-target="#loginModal">Login</button>
                            </li>
                            <li class="nav-item">
                                <button class="btn btn-outline-info ms-lg-2" data-bs-toggle="modal" data-bs-target="#cadastroModal">Cadastro</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTEÚDO -->
    <div class="container py-5 mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- MODAL LOGIN -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-light border-0 shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="loginModalLabel">Entrar no Saber+</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Usuario" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" name="email" class="form-control bg-dark border-secondary text-light" required />
                        </div>
                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha</label>
                            <input type="password" name="senha" class="form-control bg-dark border-secondary text-light" required />
                        </div>

                        <!-- Botão Entrar -->
                        <button type="submit" class="btn btn-primary w-100">Entrar</button>

                        <!-- 🔹 Link Esqueci minha senha -->
                        <div class="text-center mt-3">
                            <a href="/Usuario/RedefinirSenha" class="text-warning text-decoration-none">
                                Esqueci minha senha
                            </a>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-secondary">
                    <span class="text-muted me-auto">Não tem conta?</span>
                    <button type="button" class="btn btn-outline-info" data-bs-target="#cadastroModal" data-bs-toggle="modal" data-bs-dismiss="modal">
                        Cadastrar-se
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- MODAL CADASTRO -->
    <div class="modal fade" id="cadastroModal" tabindex="-1" aria-labelledby="cadastroModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content text-light border-0 shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="cadastroModalLabel">Criar Conta</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Usuario" asp-action="Cadastro" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nome completo</label>
                                <input name="NomeCompleto" class="form-control bg-dark border-secondary text-light" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo de pessoa</label>
                                <select name="TipoPessoa" class="form-select bg-dark border-secondary text-light" required>
                                    <option value="">Selecione...</option>
                                    <option value="Física">Pessoa Física</option>
                                    <option value="Jurídica">Pessoa Jurídica</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">CPF ou CNPJ</label>
                                <input name="Documento" class="form-control bg-dark border-secondary text-light" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Data de Nascimento</label>
                                <input type="date" name="DataNascimento" class="form-control bg-dark border-secondary text-light" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-mail</label>
                                <input type="email" name="Email" class="form-control bg-dark border-secondary text-light" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Senha</label>
                                <input type="password" name="Senha" class="form-control bg-dark border-secondary text-light" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 mt-4">Cadastrar</button>
                    </form>
                </div>
                <div class="modal-footer border-secondary">
                    <span class="text-muted me-auto">Já tem conta?</span>
                    <button type="button" class="btn btn-outline-info" data-bs-target="#loginModal" data-bs-toggle="modal" data-bs-dismiss="modal">Fazer login</button>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer saber-footer mt-auto py-3 text-center">
        <div class="container">
            <span>&copy; @DateTime.Now.Year - <strong>Saber+</strong></span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
