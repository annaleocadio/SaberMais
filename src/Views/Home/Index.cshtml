@model IEnumerable<SaberMais.Models.Curso>

<div class="container mt-5 pt-4">
    <div class="text-center mb-4">
        <h2 class="text-light fw-bold">Cursos em alta</h2>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4 justify-content-center">
            @foreach (var curso in Model)
            {
                <div class="col-md-3">
                    <div class="card bg-dark text-light border-0 shadow-sm h-100">
                        <img src="@curso.ImagemPath" class="card-img-top rounded-top" style="height: 180px; object-fit: cover;" alt="@curso.Titulo" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-info">@curso.Titulo</h5>
                            <p class="card-text text-muted small mb-1">
                                <strong>Responsável:</strong> Saber+
                            </p>
                            <p class="text-muted small mb-2">
                                <strong>Publicado em:</strong> @curso.CreatedAt.ToString("dd/MM/yyyy")
                            </p>
                            <p class="text-success fw-semibold">R$ @curso.Valor.ToString("F2")</p>
                            <p class="text-secondary small flex-grow-1">
                                @curso.Descricao?.Substring(0, Math.Min(100, curso.Descricao.Length))...
                            </p>
                            <a href="#" class="btn btn-outline-info mt-auto w-100">Ver Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted mt-5">Nenhum curso cadastrado ainda.</p>
    }
</div>
