@model IEnumerable<SaberMais.Models.Administrador>

@{
    ViewData["Title"] = "Administradores";
}

<h2 class="text-center mt-3">Lista de Administradores</h2>

<div class="text-end mb-3">
    <a asp-action="Criar" class="btn btn-primary">+ Novo Administrador</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Super Admin</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Email</td>
                <td>@(item.IsSuperAdmin ? "Sim" : "Não")</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Excluir" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
