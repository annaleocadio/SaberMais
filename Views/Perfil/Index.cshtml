@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container mt-4">
    <h2 class="text-center">Meu Perfil</h2>

    <div class="card shadow-sm mt-3 p-4">
        <h4>Bem-vindo, @ViewBag.Nome!</h4>
        <p><strong>Tipo de conta:</strong> @ViewBag.Tipo</p>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["Sucesso"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["Erro"]</div>
        }

        @if (ViewBag.Tipo == "Usuario")
        {
            <hr />
            <p>Esta é sua área pessoal. Aqui futuramente você poderá editar suas informações, visualizar cursos e acompanhar seu progresso.</p>
        }
    </div>

    @* ====================================================== *@
    @* SEÇÃO PARA ADMINISTRADORES *@
    @* ====================================================== *@

    @if (ViewBag.Tipo == "Administrador")
    {
        <hr />
        <h3 class="mt-5">Painel de Controle</h3>

        <!-- ==================== USUÁRIOS ==================== -->
        <h4 class="mt-3">Usuários Cadastrados</h4>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in ViewBag.Usuarios)
                {
                    <tr>
                        <td>@u.NomeCompleto</td>
                        <td>@u.Email</td>
                        <td>
                            <form asp-action="ApagarUsuario" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-danger btn-sm">Excluir</button>
                            </form>
                            <form asp-action="BloquearUsuario" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-warning btn-sm">Bloquear</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- ==================== CURSOS ==================== -->
        <h4 class="mt-5">Cursos Cadastrados</h4>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in ViewBag.Cursos)
                {
                    <tr>
                        <td>@c.Titulo</td>
                        <td>
                            <a asp-action="EditarCurso" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Editar</a>

                            <form asp-action="ApagarCurso" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button class="btn btn-danger btn-sm">Excluir</button>
                            </form>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

        <!-- ==================== SUPER ADMIN ==================== -->
        @if (ViewBag.IsSuperAdmin == true)
        {
            <hr />
            <h3 class="mt-5 text-success">Gerenciamento de Administradores</h3>

            <h5 class="mt-4">Cadastrar novo administrador</h5>
            <form asp-action="CriarAdministrador" method="post" class="mb-4">
                <div class="row g-2">
                    <div class="col-md-3">
                        <input type="text" name="nome" placeholder="Nome" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <input type="email" name="email" placeholder="E-mail" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <input type="password" name="senha" placeholder="Senha" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100">Cadastrar</button>
                    </div>
                </div>
            </form>

            <h5 class="mt-4">Administradores existentes</h5>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Super Admin</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in ViewBag.Administradores)
                    {
                        <tr>
                            <td>@a.Nome</td>
                            <td>@a.Email</td>
                            <td>@(a.IsSuperAdmin ? "Sim" : "Não")</td>
                            <td>
                                @if (a.IsSuperAdmin == false)
                                {
                                    <form asp-action="ExcluirAdministrador" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-danger btn-sm">Excluir</button>
                                    </form>
                                    <form asp-action="BloquearAdministrador" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-warning btn-sm">Bloquear</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>
